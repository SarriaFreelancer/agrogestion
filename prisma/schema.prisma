// Prisma Schema for AgroSaaS Platform
// This schema will be generated dynamically to support MySQL, SQL Server, and Oracle.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
} // We'll update this dynamically in the backend based on the client configuration

// ==============================
// SAAS MULTI-TENANT CORE
// ==============================

enum RoleName {
  ADMIN
  SUPERADMIN
  USER
}

enum DatabaseEngine {
  MYSQL
  POSTGRESQL
  SQLSERVER
}

enum DatabaseType {
  SHARED
  DEDICATED
}

model Role {
  id      Int          @id @default(autoincrement())
  name    RoleName     @unique
  users   User[]
  modules RoleModule[]
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password      String
  name          String?
  roleId        Int?
  role          Role?    @relation(fields: [roleId], references: [id])
  
  companyId     Int?
  company       Company? @relation(fields: [companyId], references: [id])
  plantaId      String?
  planta        Planta?  @relation(fields: [plantaId], references: [id])
  position      String?
  preferences   Json?
  lastLogin     DateTime?
  
  auditLogs     AuditLog[]
  loginHistories LoginHistory[]
  sessions      UserSession[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([companyId])
  @@index([plantaId])
}

model Company {
  id             Int       @id @default(autoincrement())
  nit            String?   @unique
  name           String    @unique
  planId         String?   
  maxUsers       Int?      
  maxProducts    Int?      
  maxPlantas     Int?
  
  serverId       String?
  server         Server?   @relation("ServerCompanies", fields: [serverId], references: [id])
  ownedServers   Server[]  @relation("CompanyServers")
  
  databaseName   String?
  databaseType   DatabaseType? 
  currentVersion String?   
  
  address        String?
  city           String?
  country        String    @default("Colombia")
  status         String    @default("ACTIVE")  // ACTIVE, SUSPENDED, INACTIVE
  themeConfig    Json?
  modulosPrincipales   Json?
  modulosConfiguracion Json?
  
  setting        CompanySetting?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  // Relaciones
  users          User[]
  modules        CompanyModule[]
  auditLogs      AuditLog[]
  loginHistories LoginHistory[]
  sessions       UserSession[]
  
  // Relaciones Tenantizadas (Agro)
  plantas        Planta[]
  sectores       Sector[]
  fincas         Finca[]
  lotes          Lote[]
  suertes        Suerte[]
  cultivos       Cultivo[]
  unidades       Unidad[]
  gruposActividad GrupoActividad[]
  actividades    Actividad[]
  tiposProducto  TipoProducto[]
  productos      Producto[]
  proveedores    Proveedor[]
  cuadrillas     Cuadrilla[]
  trabajadores   Trabajador[]
  tiposMaquinaria TipoMaquinaria[]
  maquinarias    Maquinaria[]
  planificaciones Planificacion[]
  movimientosInventario MovimientoInventario[]
  clientesConfig ClienteConfig[]

  @@index([name])
}

model Server {
  id       String         @id @default(cuid())
  name     String
  engine   DatabaseEngine
  host     String
  port     Int
  username String
  password String         
  ssl      Boolean        @default(false)
  active   Boolean        @default(true)
  companies Company[]     @relation("ServerCompanies")
  ownerId   Int?
  owner     Company?      @relation("CompanyServers", fields: [ownerId], references: [id])
}

model Module {
  id          Int             @id @default(autoincrement())
  name        String          @unique    
  description String?
  isActive    Boolean         @default(true)
  icon        String?                    
  href        String?                    
  roles       RoleModule[]
  companies   CompanyModule[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model RoleModule {
  roleId   Int
  moduleId Int
  role     Role   @relation(fields: [roleId], references: [id])
  module   Module @relation(fields: [moduleId], references: [id])
  @@id([roleId, moduleId])
}

model CompanyModule {
  companyId Int
  moduleId  Int
  company   Company @relation(fields: [companyId], references: [id])
  module    Module  @relation(fields: [moduleId], references: [id])
  @@id([companyId, moduleId])
}

model AuditLog {
  id              Int      @id @default(autoincrement())
  companyId       Int?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          Int?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  module          String   
  action          String   
  entity          String   
  entityId        String?  // Changed to String since many of your entities use UUIDs
  description     String   @db.Text
  oldValues       Json?    
  newValues       Json?    
  ip              String?
  browser         String?
  operatingSystem String?
  device          String?
  country         String?
  city            String?
  sessionId       String?
  createdAt       DateTime @default(now())
  
  @@index([companyId])
  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
}

model LoginHistory {
  id              Int      @id @default(autoincrement())
  userId          Int?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  companyId       Int?
  company         Company? @relation(fields: [companyId], references: [id])
  ip              String?
  browser         String?
  operatingSystem String?
  device          String?
  country         String?
  city            String?
  status          String   
  reason          String?  
  createdAt       DateTime @default(now())
  
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

model UserSession {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId       Int?
  company         Company? @relation(fields: [companyId], references: [id])
  token           String   @unique
  ip              String?
  browser         String?
  operatingSystem String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  
  @@index([userId])
}

model CompanySetting {
  id                    Int      @id @default(autoincrement())
  companyId             Int      @unique
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nit                   String?
  phone                 String?
  website               String?
  socialMedia           Json?
  invoiceConfig         Json?     
  currency              String   @default("COP")
  timezone              String   @default("America/Bogota")
  dateFormat            String   @default("YYYY-MM-DD")
  currencyFormat        String   @default("es-CO")
  allowNegativeStock    Boolean  @default(false)
  automaticCode         Boolean  @default(true)
  decimals              Int      @default(0)
  defaultIva            Float    @default(19.0)
  invoicePrefix         String   @default("VEN")
  invoiceConsecutive    Int      @default(1)
  purchasePrefix        String   @default("COM")
  purchaseConsecutive   Int      @default(1)
  passwordMinLength     Int      @default(6)
  maxLoginAttempts      Int      @default(5)
  sessionTimeoutMinutes Int      @default(60)
  enable2FA             Boolean  @default(false)
  enableNotifications   Boolean  @default(true)
  smtpHost              String?
  smtpPort              Int?
  smtpUser              String?
  smtpPass              String?
  backupFrequency       String   @default("DAILY")
  backupTime            String?  @default("02:00")
  backupDay             Int?     @default(1)
  backupPath            String?
  updatedAt             DateTime @updatedAt
}

// ==============================
// 1. ESTRUCTURA GEOGRÁFICA
// ==============================

model Planta {
  id        String   @id @default(uuid())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  cultivos  Cultivo[]
  users     User[]
  sectores  Sector[]
  
  @@index([companyId])
}

model Sector {
  id            String   @id @default(uuid())
  companyId     Int?
  company       Company? @relation(fields: [companyId], references: [id])
  codigo        String
  name          String
  type          String   @default("Sector")
  plantaId      String
  planta        Planta   @relation(fields: [plantaId], references: [id])
  plantaCliente String?
  fincas        Finca[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
}

model Finca {
  id        String   @id @default(uuid())
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  codigo    String?
  name      String
  type      String   @default("Finca")
  sectorId  String
  sector    Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  lotes     Lote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Lote {
  id        String   @id @default(uuid())
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  codigo    String?
  name      String
  type      String   @default("Lote")
  fincaId   String
  finca     Finca    @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  suertes   Suerte[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Suerte {
  id                    String   @id @default(uuid())
  companyId             Int?
  company               Company? @relation(fields: [companyId], references: [id])
  codigo                String?
  name                  String
  type                  String   @default("Suerte")
  hectareas             Float?
  plantas               Int?
  tareas                Float?
  toneladas             Float?
  cultivo               String?
  estado                String   @default("Activo")
  estadoProductivo      String?
  edadSuerteDias        Int?     @default(0)
  edadUltimaCosechaDias Int?     @default(0)
  geometria             Json?
  loteId                String
  lote                  Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([companyId])
}

// ==============================
// 2. MAESTROS Y CONFIGURACIONES
// ==============================

model Cultivo {
  id        String   @id @default(uuid())
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  plantaId  String
  planta    Planta   @relation(fields: [plantaId], references: [id])
  codigo    String?
  name      String
  estado    String   @default("Activo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([plantaId])
}

model Unidad {
  id        String   @id @default(uuid())
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  codigo    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model GrupoActividad {
  id          String      @id @default(uuid())
  companyId   Int?
  company     Company?    @relation(fields: [companyId], references: [id])
  codigo      String?
  name        String
  actividades Actividad[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([companyId])
}

model Actividad {
  id                String          @id @default(uuid())
  companyId         Int?
  company           Company?        @relation(fields: [companyId], references: [id])
  code              String?
  name              String
  groupId           String?
  grupo             GrupoActividad? @relation(fields: [groupId], references: [id])
  cultivo           String?
  tipo              String?
  clasificacion     String?
  unidadProduccion  String?
  unidadMedida      String?
  tarifaBase        Float           @default(0)
  productosEstandar Json? 
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([companyId])
}

model TipoProducto {
  id        String     @id @default(uuid())
  companyId Int?
  company   Company?   @relation(fields: [companyId], references: [id])
  nombre    String
  productos Producto[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([companyId])
}

model Producto {
  id            String       @id @default(uuid())
  companyId     Int?
  company       Company?     @relation(fields: [companyId], references: [id])
  codigo        String?
  nombre        String
  tipoId        String
  tipo          TipoProducto @relation(fields: [tipoId], references: [id])
  unidadMedida  String
  stockActual   Float        @default(0)
  costoUnitario Float        @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([companyId])
}

model Proveedor {
  id        String   @id @default(uuid())
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  nombre    String
  tipo      String
  contacto  String?
  telefono  String?
  email     String?
  estado    String   @default("Activo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// ==============================
// 3. PERSONAL Y MAQUINARIA
// ==============================

model Cuadrilla {
  id           String       @id @default(uuid())
  companyId    Int?
  company      Company?     @relation(fields: [companyId], references: [id])
  codigo       String?
  nombre       String
  jefeId       String?
  trabajadores Trabajador[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([companyId])
}

model Trabajador {
  id             String     @id @default(uuid())
  companyId      Int?
  company        Company?   @relation(fields: [companyId], references: [id])
  identificacion String
  nombre         String
  apellido       String
  cargo          String
  estado         String     @default("Activo")
  cuadrillaId    String?
  cuadrilla      Cuadrilla? @relation(fields: [cuadrillaId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([companyId])
}

model TipoMaquinaria {
  id          String       @id @default(uuid())
  companyId   Int?
  company     Company?     @relation(fields: [companyId], references: [id])
  nombre      String
  maquinarias Maquinaria[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([companyId])
}

model Maquinaria {
  id                       String         @id @default(uuid())
  companyId                Int?
  company                  Company?       @relation(fields: [companyId], references: [id])
  codigo                   String
  name                     String
  tipoId                   String
  tipo                     TipoMaquinaria @relation(fields: [tipoId], references: [id])
  status                   String         @default("Operativo")
  propiaAlquilada          String
  tarifa                   Float          @default(0)
  horometroActual          Float          @default(0)
  ultimoMantenimientoHoras Float?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([companyId])
}

// ==============================
// 4. PLANIFICACIÓN Y EJECUCIÓN
// ==============================

model Planificacion {
  id                  String   @id @default(uuid())
  companyId           Int?
  company             Company? @relation(fields: [companyId], references: [id])
  ordenCode           String?
  estado              String   @default("Borrador")
  actividadId         String
  actividadNombre     String
  estructuraId        String
  estructuraNombre    String
  hectareasPlaneadas  Float
  hectareasEjecutadas Float    @default(0)
  cultivo             String?
  prioridad           String?
  notas               String?
  insumosJson         Json?
  ejecucionesJson     Json? 
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([companyId])
}

model MovimientoInventario {
  id            String   @id @default(uuid())
  companyId     Int?
  company       Company? @relation(fields: [companyId], references: [id])
  fecha         DateTime @default(now())
  productoId    String
  tipo          String 
  cantidad      Float
  motivo        String?
  costoUnitario Float    @default(0)

  @@index([companyId])
}

// ==============================
// 5. CONFIGURACIÓN CLIENTE
// ==============================

model ClienteConfig {
  id        String   @id @default(uuid())
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  clave     String   @unique
  valor     Json
  modulo    String?

  @@index([companyId])
}
